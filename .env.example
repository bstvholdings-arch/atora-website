# Session secret for admin JWT signing (change in production!)
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Admin default credentials (used by `npm run admin:create`)
ADMIN_DEFAULT_EMAIL=admin@atora.com.my
ADMIN_DEFAULT_PASSWORD=Atora@2026
ADMIN_DEFAULT_NAME=Administrator

# Database file path (relative to project root)
DATABASE_PATH=./data/atora.db

# Upload directory
UPLOAD_DIR=./public/uploads

# Public site URL (used for SEO canonical & sitemap)
NEXT_PUBLIC_SITE_URL=https://atora.com.my
